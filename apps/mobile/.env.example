# Backend base URL (with /api prefix), matching apps/web's NEXT_PUBLIC_API_URL.
# On a physical device or Android emulator, "localhost" refers to the device itself,
# not your dev machine - use your machine's LAN IP (e.g. http://192.168.1.20:3000/api)
# or the Android emulator alias 10.0.2.2 instead.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# expo-auth-session Google OAuth client ids (Section 10) - must correspond to the
# backend's existing OAuth app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

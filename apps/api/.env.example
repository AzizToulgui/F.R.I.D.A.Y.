# Copy to .env.development / .env.production and fill in real values.
# Never commit an actual .env file.

NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
# Dev docker-compose.yml publishes Postgres on 5433 (not 5432) in case the
# host already has a native Postgres service bound to the default port.
DB_PORT=5433
DB_USERNAME=jarvis
DB_PASSWORD=changeme
DB_NAME=jarvis
# Never true in production - use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-hex-string
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=jarvis
JWT_AUDIENCE=jarvis-clients

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Gemini (not called yet in Step 2 - populate before Step 4) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CONVERSATION_MAX_HISTORY_TOKENS=4000

# --- Google OAuth (Gmail + Calendar tools, "Continue with Google") ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# with GOOGLE_REDIRECT_URI added as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Web search uses Gemini's native Google Search grounding tool - no separate
# API key needed, see GeminiProvider.toGeminiTools.

VOICE_MEMO_MAX_UPLOAD_BYTES=10485760

LOG_LEVEL=info

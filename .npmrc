
# Relocates pnpm's .pnpm virtual store out of the deeply-nested OneDrive project path.
# Needed on Windows: react-native-worklets' native CMake build fails ("ninja: manifest still
# dirty after 100 tries") when object file paths exceed CMake's CMAKE_OBJECT_PATH_MAX (250
# chars), which happens once you stack pnpm's hashed store folder names on top of this repo's
# full OneDrive path. This is independent of the Windows long-path OS setting - CMake enforces
# this limit itself regardless of what the OS actually supports.
virtual-store-dir=C:\pnpm-store\.pnpm
